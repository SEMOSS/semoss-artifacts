<!-- The contents of this file will be loaded for each web application -->
<Context>
    <Resources allowLinking="true" />
    <!-- Default set of monitored resources. If one of these changes, the    -->
    <!-- web application will be reloaded.                                   -->
    <WatchedResource>WEB-INF/web.xml</WatchedResource>
    <WatchedResource>WEB-INF/tomcat-web.xml</WatchedResource>
    <WatchedResource>${catalina.base}/conf/web.xml</WatchedResource>
    <CookieProcessor className="org.apache.tomcat.util.http.Rfc6265CookieProcessor" sameSiteCookies="unset" />
    <!-- Session persistence is OFF by default in Tomcat 11 (pathname defaults to -->
    <!-- null). Uncomment this to enable it across Tomcat restarts:               -->
    <!--
    <Manager pathname="SESSIONS.ser" />
    -->
    <!-- Session ID entropy. Tomcat's own default is secureRandomAlgorithm       -->
    <!-- "SHA1PRNG" with no provider, and the defaults below reproduce that      -->
    <!-- exactly, so leaving these unset changes nothing.                        -->
    <!--                                                                         -->
    <!-- Override per deployment with container environment variables:           -->
    <!--   SESSION_SECURE_RANDOM_PROVIDER=BCFIPS                                 -->
    <!--   SESSION_SECURE_RANDOM_ALGORITHM=DEFAULT                               -->
    <!-- FIPS 140-3 deployments MUST set both. BCFIPS does not implement         -->
    <!-- SHA1PRNG, so Tomcat's default silently resolves to SUN and JSESSIONID   -->
    <!-- entropy comes from outside the validated module with nothing logged.    -->
    <!--                                                                         -->
    <!-- Env var substitution needs EnvironmentPropertySource, which setenv.sh   -->
    <!-- enables via org.apache.tomcat.util.digester.PROPERTY_SOURCE. Without it -->
    <!-- the ":-" defaults still apply, so this stays safe either way.           -->
    <!--                                                                         -->
    <!-- An empty provider is treated by Tomcat as "no provider specified".      -->
    <!-- StandardManager.pathname defaults to null, so this does not switch on   -->
    <!-- session persistence to disk.                                            -->
    <Manager secureRandomProvider="${SESSION_SECURE_RANDOM_PROVIDER:-}"
             secureRandomAlgorithm="${SESSION_SECURE_RANDOM_ALGORITHM:-SHA1PRNG}" />
</Context>