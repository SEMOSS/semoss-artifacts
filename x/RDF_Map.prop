# ------------------------------------------------------------
# Paths and folders
# ------------------------------------------------------------
BaseFolder	/opt/semosshome
LOG4J	/opt/semosshome/log4j.prop
INSIGHT_CACHE_DIR /opt/semosshome/InsightCache
CSV_INSIGHT_CACHE_FOLDER CSV_Insights
SOCIAL	/opt/semosshome/social.properties
EMAIL_TEMPLATES	/opt/semosshome/emailTemplates/
ADDITIONAL_REACTORS /opt/semosshome/reactors.json
ADDITIONAL_REACTOR_PACKAGES  
SHARED_FILE_PATH

# ------------------------------------------------------------
# Engine and project watchers
# ------------------------------------------------------------
ENGINE_WEB_WATCHER	SMSSWebWatcher;SMSSStorageWatcher;SMSSModelWatcher;SMSSVectorWatcher;SMSSFunctionWatcher;SMSSGuardrailWatcher
PROJECT_WATCHER	ProjectWatcher

SMSSWebWatcher	prerna.util.SMSSWebWatcher
SMSSWebWatcher_DIR	/opt/semosshome/db
SMSSWebWatcher_EXT	.smss
SMSSWebWatcher_ETYPE	DATABASE

SMSSStorageWatcher	prerna.util.SMSSNoInitEngineWatcher
SMSSStorageWatcher_DIR	/opt/semosshome/storage
SMSSStorageWatcher_EXT	.smss
SMSSStorageWatcher_ETYPE	STORAGE

SMSSModelWatcher	prerna.util.SMSSNoInitEngineWatcher
SMSSModelWatcher_DIR	/opt/semosshome/model
SMSSModelWatcher_EXT	.smss
SMSSModelWatcher_ETYPE	MODEL

SMSSVectorWatcher	prerna.util.SMSSNoInitEngineWatcher
SMSSVectorWatcher_DIR	/opt/semosshome/vector
SMSSVectorWatcher_EXT	.smss
SMSSVectorWatcher_ETYPE	VECTOR

SMSSFunctionWatcher prerna.util.SMSSNoInitEngineWatcher
SMSSFunctionWatcher_DIR /opt/semosshome/function
SMSSFunctionWatcher_EXT .smss
SMSSFunctionWatcher_ETYPE	FUNCTION

SMSSGuardrailWatcher    prerna.util.SMSSNoInitEngineWatcher
SMSSGuardrailWatcher_DIR	/opt/semosshome/guardrail
SMSSGuardrailWatcher_EXT	.smss
SMSSGuardrailWatcher_ETYPE	GUARDRAIL

#SMSSVenvWatcher	prerna.util.SMSSNoInitEngineWatcher
#SMSSVenvWatcher_DIR	opt/semosshome/function/venv
#SMSSVenvWatcher_EXT	.smss
#SMSSVenvWatcher_ETYPE	VENV

ProjectWatcher	prerna.util.ProjectWatcher
ProjectWatcher_DIR  /opt/semosshome/project
ProjectWatcher_EXT	.smss

#JobSchedulerWatcher prerna.rpa.JobSchedulerWatcher
#JobSchedulerWatcher_DIR /opt/semosshome/rpa/json
#JobSchedulerWatcher_EXT	.json

# ------------------------------------------------------------
# Deployment and web
# ------------------------------------------------------------
MONOLITH_ROUTE
LOAD_BALANCER_COOKIE_NAME
#WHAT SAMESITE COOKIE VALUE DO YOU WANT USED
#POSSIBLE VALUES INCLUDE strict, lax, none
SAMESITE_COOKIE none
#SET WHITE LIST DOMAINS
WHITE_LIST_DOMAINS  
X_CACHE false
SHOW_WELCOME_BANNER true

# ------------------------------------------------------------
# Python
# ------------------------------------------------------------
USE_PYTHON true
PYTHONHOME /usr/lib/python/semossvenv
PYTHONHOME_SITE_PACKAGES
#name of the user that runs the native python server
PY_SERVER_USER

#LD should be picked from env vars
#LD_LIBRARY_PATH /usr/local/lib/python3.5/dist-packages/jep

# ------------------------------------------------------------
# R
# ------------------------------------------------------------
USE_R	true
R_MEM_LIMIT	4096
R_CONNECTION_JRI	false
#JRI must be false in order to use user rserve
IS_USER_RSERVE	false
#Options are pooled or dedicated
R_USER_CONNECTION_TYPE	pooled
RSERVE_CONNECTION_POOL_SIZE	6
R_USER_RECOVERY_DEFAULT false
#Kill existing Rserve processes on startup
R_KILL_ON_STARTUP true

#true runs R in the user's Java worker process
NETTY_R false

# ------------------------------------------------------------
# User processes, chroot and sandbox
# ------------------------------------------------------------
ULIMIT_PROCESS
CHROOT_DIR /opt/chroot
CHROOT_ENABLE true
CHROOT_SYMLINK_PATHS /usr/lib/python
# Python user-process sandbox mode. FAKECHROOT preserves the existing behavior;
# set SANDBOX_MODE to NAMESPACE to use the Linux namespace jail.
SANDBOX_MODE FAKECHROOT
# Colon-separated executable directories exposed inside native Python and CmdExecUtil sandboxes.
SANDBOX_PATH /usr/lib/python/semossvenv/bin:/usr/local/bin:/usr/bin:/bin
SANDBOX_IO_DIR /tmp/semoss-sandbox

# ------------------------------------------------------------
# Terminals
# ------------------------------------------------------------
DISABLE_TERMINAL
DISABLE_R_TERMINAL
DISABLE_PY_TERMINAL
DISABLE_GIT_TERMINAL

# ------------------------------------------------------------
# Frames and defaults
# ------------------------------------------------------------
#SET DEFAULT FRAME TO LOAD DATA
#Frame type options: GRID, R, NATIVE, GRAPH
DEFAULT_FRAME_TYPE GRID
#CURRENTLY ONLY SUPPORT VALUES OF : H2_DB OR SQLITE
DEFAULT_GRID_TYPE H2_DB
#SET THE DEFAULT SCRIPTING LANGUAGE
#THIS WILL DETERMINE IF WE SWITCH TO R OR PY IN CLEAN/ANALYTICS
DEFAULT_SCRIPTING_LANGUAGE R
#SET DEFAULT INSIGHTS RDBMS 
#CURRENTLY ONLY SUPPORT VALUES OF : H2_DB OR SQLITE
#DEFAULT IS H2_DB IF THIS IS REMOVED
DEFAULT_INSIGHTS_RDBMS H2_DB

#SIZE LIMIT FOR ROW by COL 
#FOR NO LIMIT USE -1
FRAME_SIZE_LIMIT -1
#DO WE LIMIT FOR NATIVE FRAMES
FRAME_SIZE_LIMIT_NATIVE false
#SET RESTRICTIONS ON PIVOT SIZE
PIVOT_ROW_MAX	1000
PIVOT_COL_MAX	100

# ------------------------------------------------------------
# Insight cache
# ------------------------------------------------------------
#SET IF INSIGHTS ON SAVE ARE CACHEABLE
DEFAULT_INSIGHT_CACHEABLE	 true
DEFAULT_INSIGHT_CACHE_MINUTES	 -1
DEFAULT_INSIGHT_CACHE_CRON
DEFAULT_INSIGHT_CACHE_ENCRYPT	 false

# ------------------------------------------------------------
# Memory and file limits
# ------------------------------------------------------------
CHECK_MEM	false
MEM_PROFILE_SETTINGS	CONSTANT
# specification in gigs
USER_MEM_LIMIT	2
RESERVED_JAVA_MEM	12
FILE_TRANSFER_LIMIT 50

# ------------------------------------------------------------
# Export
# ------------------------------------------------------------
PLAYWRIGHT_EXPORT true

# ------------------------------------------------------------
# Project app builds
# ------------------------------------------------------------
#URL of the SEMOSS node-builder service; BuildAndPublishApp sends a project's assets/client source there to build it
NODE_SERVER_ENDPOINT

# ------------------------------------------------------------
# Scheduler
# ------------------------------------------------------------
#SCHEDULER ENDPOINT - ONLY THE ROOT OF THE URL - example: http://localhost:8080/Monolith
SCHEDULER_ENDPOINT	http://localhost:8080/Monolith
SCHEDULER_KEYSTORE  
SCHEDULER_KEYSTORE_PASSWORD  
SCHEDULER_CERTIFICATE_PASSWORD  
SCHEDULER_FORCE_DISABLE  

# ------------------------------------------------------------
# Logging
# ------------------------------------------------------------
#LOGGING: secret salt (hex) for values hashed in logs, blank logs unsalted SHA-256; true sends Python output to the SEMOSS log
LOG_HASH_SALT	
PY_LOG_CAPTURE_ENABLED	false

# ------------------------------------------------------------
# System databases and tracking
# ------------------------------------------------------------
MODEL_INFERENCE_LOGS_ENABLED true
PROMPT_DB_ENABLED   false
AUDIT_LOGS_DATABASE_ENABLED false
COLLABORATION_DATABASE_ENABLED false
USER_TRACKING_ENABLED	false
USER_TRACKING_METHOD	GEOIP2

# ------------------------------------------------------------
# Collaboration (Brain/Work)
# ------------------------------------------------------------
#COLLABORATION (Brain/Work) classifier engine id and optional per-engine cutoffs JSON
COLLAB_CLASSIFIER_ENGINE_ID	
COLLAB_CLASSIFIER_CUTOFFS	
#COLLABORATION (Brain/Work) text model: an engine id users can view; blank turns Brain's text features off
COLLAB_LLM_ENGINE_ID	
#COLLABORATION tuning; blank uses the default in brackets
#minutes a routine's agent step may run [10]
COLLAB_ROUTINE_TIMEOUT_MINUTES	
#characters of recalled memory added to a prompt [4000]
COLLAB_MEMORY_PROMPT_CHARS	
#size limit for one email attachment Brain handles, in MB [10]
COLLAB_ATTACHMENT_MAX_MB	
#files sent with a delegation to a person: how many [10], MB each [25], MB in total [100]
COLLAB_DELEGATION_MAX_FILES	
COLLAB_DELEGATION_MAX_FILE_MB	
COLLAB_DELEGATION_MAX_TOTAL_MB	
#classifier context window per engine as JSON, {"<engine id>": <tokens>} [built-in]
COLLAB_CLASSIFIER_WINDOW	
#how many run at once: thread classifier [8, max 32], work items [3, max 16], work extraction [5, max 16]
COLLAB_CLASSIFY_PARALLEL	
COLLAB_WORK_ITEMS_PARALLEL	
COLLAB_WORK_EXTRACT_PARALLEL	

# ------------------------------------------------------------
# Agents
# ------------------------------------------------------------
AGENT_DEFAULT_TOOLS_MCP_PROJECT_ID
AGENT_DEFAULT_TOOLS_ENABLE_BASH true
#web search tool: needs a SearXNG service (SEARXNG_URL)
WEB_SEARCH_ENABLED	false

# true runs agents inside the sandbox and refuses to start one when the sandbox is unavailable; false (default) runs them without it
AGENT_SANDBOX_ENABLE	false
# Comma-separated absolute paths granted read-only access inside the sandbox. Leave blank to use OS defaults (/usr/lib, /System, java.home, etc.)
AGENT_SANDBOX_DEFAULT_READS
# Comma-separated absolute paths the sandboxed agent may not read, added to the built-in block list
AGENT_SANDBOX_BLOCK_READS
# Allow the sandboxed agent to reach localhost (required for MCP server callbacks)
AGENT_SANDBOX_LOOPBACK_NETWORK	true
# Absolute path to the Claude Code CLI binary. Leave blank to probe common install locations.
CLAUDE_CODE_CLI_PATH
# Absolute path to the GitHub Copilot CLI binary. Leave blank to probe common install locations.
GITHUB_COPILOT_CLI_PATH

A2A_ENABLED false
A2A_AGENT_CARD_BASE_URL
A2A_DEFAULT_MODEL_ID

# ------------------------------------------------------------
# Rooms and agent run coordination
# ------------------------------------------------------------
ROOM_MESSAGE_STORE_LOCK_TTL_MS 300000
ROOM_MESSAGE_STORE_LOCK_WAIT_MS 5000
ROOM_MESSAGE_REDIS_TTL_HOURS 1
AGENT_RUN_QUEUE_ENABLED
AGENT_RUN_ACTIVE_TTL_MS 300000
AGENT_RUN_WAIT_TIMEOUT_MS 3600000

# ------------------------------------------------------------
# Redis
# ------------------------------------------------------------
REDIS_ENABLED false
REDIS_HOST localhost
REDIS_PORT 6379
REDIS_PASSWORD
REDIS_TIMEOUT_MS 2000
REDIS_POOL_MAX_TOTAL 64
REDIS_POOL_MAX_IDLE 16
REDIS_POOL_MIN_IDLE 1
REDIS_SENTINEL_ENABLED false
REDIS_MASTER_NAME
REDIS_SENTINEL_NODES
REDIS_SENTINEL_PASSWORD
REDIS_CLUSTER_ENABLED false
REDIS_CLUSTER_NODES
REDIS_CLUSTER_MAX_ATTEMPTS 5

# ------------------------------------------------------------
# Secrets
# ------------------------------------------------------------
SECRET_STORE_ENABLED	false
#HASHICORP_VAULT, AZURE_KEYVAULT or AWS_SECRETS_MANAGER
SECRET_STORE_TYPE		
