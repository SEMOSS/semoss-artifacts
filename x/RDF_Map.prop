SECRETS_DB_PATH
SECRETS_STORAGE_PATH
SECRETS_MODEL_PATH
SECRETS_VECTOR_PATH
SECRETS_FUNCTION_PATH
SECRETS_GUARDRAIL_PATH
SECRETS_PROJECT_PATH
SECRETS_VENV_PATH

#Hashicorp Vault
VAULT_ADDR				
VAULT_TOKEN				

#Azure KeyVault
#Note SECRET_*_PATH can only be contain alphanumeric and dashes
#ClientSecretCredential if passing in client/secret/tenant
AZURE_AUTHENTICATE_MODE	
AZURE_KEYVAULT_NAME	
AZURE_CLIENT_ID	
AZURE_CLIENT_SECRET	
AZURE_TENANT_ID 

#AWS Secrets Manager
#Note SECRETS_*_PATH can contain alphanumeric and /_+=.@-
#Leave the access key blank to use the default AWS credential chain
AWS_SECRETS_MANAGER_REGION	
AWS_SECRETS_MANAGER_ENDPOINT	
AWS_SECRETS_MANAGER_ACCESS_KEY	
AWS_SECRETS_MANAGER_SECRET_KEY	
AWS_SECRETS_MANAGER_SESSION_TOKEN	
AWS_SECRETS_MANAGER_KMS_KEY_ID	

